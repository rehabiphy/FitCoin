NODE_ENV=development
PORT=5000

# MongoDB connection string
MONGO_URI=mongodb://127.0.0.1:27017/fitcoin
# Optional: DNS servers for the backend to use, if your network's DNS can't resolve mongodb+srv:// hosts
# DNS_SERVERS=8.8.8.8,1.1.1.1

# Generate each secret with:
#   node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_ACCESS_SECRET=replace-with-a-long-random-string
JWT_REFRESH_SECRET=replace-with-a-different-long-random-string
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=30d

# Google OAuth client IDs allowed to sign in (comma separated).
# Use the *Web* client ID that the mobile app passes as `webClientId`.
GOOGLE_CLIENT_IDS=your-web-client-id.apps.googleusercontent.com

# Comma separated list of allowed browser origins (mobile apps don't send one).
# The admin panel's dev server proxies /api, so it only needs adding here when deployed on its own domain.
CORS_ORIGINS=http://localhost:8081

# true = "Upgrade to Premium" activates without payment (for testing). Defaults to true outside production.
# Set to false once real in-app purchases are connected.
# PREMIUM_TEST_PURCHASES=true

BCRYPT_SALT_ROUNDS=12
