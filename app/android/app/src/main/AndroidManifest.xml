<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.INTERNET" />

    <!-- Step counting (see java/com/rehabiphy/axiyo/steps). The step sensor needs
         ACTIVITY_RECOGNITION; a "health" foreground service keeps the process
         alive so the sensor keeps counting while the app is closed. -->
    <uses-permission android:name="android.permission.ACTIVITY_RECOGNITION" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_HEALTH" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <!-- Lets the ~90 s heartbeat run on time; it falls back to inexact alarms if not granted. -->
    <uses-permission android:name="android.permission.SCHEDULE_EXACT_ALARM" />
    <!-- Lets the app ask to be exempt from battery optimisation, which some phones use to kill the step service. -->
    <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS" />

    <uses-feature android:name="android.hardware.sensor.stepcounter" android:required="false" />

    <application
      android:name=".MainApplication"
      android:label="@string/app_name"
      android:icon="@mipmap/ic_launcher"
      android:roundIcon="@mipmap/ic_launcher_round"
      android:allowBackup="false"
      android:theme="@style/AppTheme"
      android:usesCleartextTraffic="${usesCleartextTraffic}"
      android:supportsRtl="true">
      <!-- Push notifications (FCM): status-bar icon and colour. The default channel comes from
           firebase.json; the channels themselves are created in PushChannels.kt. The colour is set
           here (not in firebase.json) because the Firebase library can't see app resources in release builds. -->
      <meta-data
        android:name="com.google.firebase.messaging.default_notification_icon"
        android:resource="@drawable/ic_stat_axyio" />
      <meta-data
        android:name="com.google.firebase.messaging.default_notification_color"
        android:resource="@color/notification_accent"
        tools:replace="android:resource" />
      <activity
        android:name=".MainActivity"
        android:label="@string/app_name"
        android:configChanges="keyboard|keyboardHidden|orientation|screenLayout|screenSize|smallestScreenSize|uiMode"
        android:launchMode="singleTask"
        android:windowSoftInputMode="adjustResize"
        android:exported="true">
        <intent-filter>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LAUNCHER" />
        </intent-filter>
        <!-- Invite links: https://axyio.vercel.app/invite/AXYIO-XXXX opens the app directly.
             autoVerify checks web/public/.well-known/assetlinks.json on each domain.
             fit-coin-lszq.vercel.app is the old website URL, kept so links shared before the move still open the app. -->
        <intent-filter android:autoVerify="true">
            <action android:name="android.intent.action.VIEW" />
            <category android:name="android.intent.category.DEFAULT" />
            <category android:name="android.intent.category.BROWSABLE" />
            <data android:scheme="https" android:host="axyio.vercel.app" android:pathPrefix="/invite/" />
            <data android:scheme="https" android:host="fit-coin-lszq.vercel.app" android:pathPrefix="/invite/" />
        </intent-filter>
        <!-- axyio://invite/AXYIO-XXXX: used by the invite page's "open the app" button -->
        <intent-filter>
            <action android:name="android.intent.action.VIEW" />
            <category android:name="android.intent.category.DEFAULT" />
            <category android:name="android.intent.category.BROWSABLE" />
            <data android:scheme="axyio" android:host="invite" />
        </intent-filter>
      </activity>

      <service
        android:name=".steps.StepTrackingService"
        android:enabled="true"
        android:exported="false"
        android:stopWithTask="false"
        android:foregroundServiceType="health" />

      <receiver android:name=".steps.StepHeartbeatReceiver" android:exported="false" />
      <receiver android:name=".steps.MidnightStepReceiver" android:exported="false" />
      <receiver android:name=".steps.StepBootReceiver" android:exported="false">
        <intent-filter>
          <action android:name="android.intent.action.BOOT_COMPLETED" />
          <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
        </intent-filter>
      </receiver>
    </application>
</manifest>
